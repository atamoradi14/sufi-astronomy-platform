# Copy values to ignored root .env; never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://fanous.online
ADMIN_EMAILS=admin@example.com
# Optional one-time-code sign-in (each channel turns on only when both of its values are set).
# Phone: Ravand's SMS relay, reached in-cluster; key = SMS_SERVICE_API_KEY of secret ravand/ravand-sms.
OTP_SMS_URL=http://sms.ravand.svc.cluster.local:8000
OTP_SMS_API_KEY=
# Email: the Azure Communication Services resource Darvazeh uses (secret darvazeh/fieldsense-secrets).
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@ndorbit.co.nz
